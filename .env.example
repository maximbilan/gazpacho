# Copy to .env for local runs. Do not commit real values.

# Optional local-only values used by scripts/login.py.
# The login script will prompt for these if they are omitted.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=from-my.telegram.org
TELETHON_STRING_SESSION=printed-by-scripts-login

# Source chats can be @usernames, numeric IDs, or invite links resolved by Telethon.
SOURCE_CHAT_IDS=@school_chat_one,@school_chat_two,@school_chat_three
TARGET_CHAT_IDS=123456789,987654321

TIMEZONE=Europe/Madrid
SOURCE_LANG=es
OUTPUT_LANG=uk
LOOKBACK_DAYS=7

# SAM/EventBridge cron is UTC. Default: daily 18:00 Europe/Madrid during CEST.
# Adjust seasonally or set your own cadence.
SCHEDULE_HOUR=16
SCHEDULE_MINUTE=0

LLM_PROVIDER=openai
LLM_MODEL_SUMMARY=gpt-4.1-mini
LLM_MODEL_QA=gpt-5-mini
# For LLM_PROVIDER=openai, set OPENAI_API_KEY locally or in Secrets Manager.
# OPENAI_API_KEY=sk-proj-...

# AWS resource names/IDs.
AWS_REGION=eu-west-1
SECRETS_MANAGER_SECRET_ID=gazpacho/secrets
DYNAMODB_TABLE_NAME=gazpacho
SCHEDULED_DIGEST_FUNCTION_NAME=gazpacho-scheduled-digest
# Backward-compatible alias accepted by the current handler/refresh path.
WEEKLY_DIGEST_FUNCTION_NAME=gazpacho-scheduled-digest
