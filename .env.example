# Copy to .env for local runs. Do not commit real values.

# Optional local-only values used by scripts/login.py.
# The login script will prompt for these if they are omitted.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=from-my.telegram.org
TELETHON_STRING_SESSION=printed-by-scripts-login

# Source chats can be @usernames, numeric IDs, or invite links resolved by Telethon.
SOURCE_CHAT_IDS=@school_chat_one,@school_chat_two,@school_chat_three
TARGET_CHAT_ID=123456789

TIMEZONE=Europe/Madrid
SOURCE_LANG=es
OUTPUT_LANG=uk
LOOKBACK_DAYS=7

# SAM/EventBridge cron is UTC. Monday 08:00 Europe/Madrid must be adjusted by season.
SCHEDULE_CRON=cron(0 6 ? * MON *)

LLM_PROVIDER=anthropic
LLM_MODEL_SUMMARY=claude-haiku-4-5-20251001
LLM_MODEL_QA=claude-sonnet-4-6

# AWS resource names/IDs.
AWS_REGION=eu-west-1
SECRETS_MANAGER_SECRET_ID=gazpacho/secrets
DYNAMODB_TABLE_NAME=gazpacho
WEEKLY_DIGEST_FUNCTION_NAME=gazpacho-weekly-digest
